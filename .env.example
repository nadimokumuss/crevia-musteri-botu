# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google Places API
GOOGLE_PLACES_API_KEY=your-google-places-api-key-here

# Google Maps Distance Matrix (opsiyonel)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Apify
APIFY_API_TOKEN=your-apify-token-here

# Outscraper (Google Business Profile reviews — Faz 1)
OUTSCRAPER_API_KEY=your-outscraper-api-key-here

# Anthropic (Sonnet audit synthesis — Faz 1 PR2)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Audit batch maksimum dolar butcesi (default 20)
MAX_DAILY_AUDIT_BUDGET_USD=20

# Sentry
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn-here
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel Deploy Hook (opsiyonel)
VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/your-hook-id
